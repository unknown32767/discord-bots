DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_USER_IDS=123456789,987654321
BASE_PROJECT_DIR=/Users/you/projects
RATE_LIMIT_PER_MINUTE=10
# Show estimated API cost in task results (set false for Max plan users)
SHOW_COST=true

# AI Provider configuration
# Default AI provider: 'claude' or 'codex'
DEFAULT_PROVIDER=claude
# OpenAI API key (required when using Codex provider)
OPENAI_API_KEY=
# Optional: pin a specific Claude model (leave blank to use CLI default).
# Useful when using a third-party Anthropic-compatible endpoint that returns an unknown model name.
# Examples: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=

# Optional: pin a specific Codex model (leave blank to use CLI default).
# Set this to avoid "Model metadata not found" warnings for new/unrecognized OpenAI models.
# Examples: o3, gpt-4o, gpt-5.6-sol
CODEX_MODEL=
